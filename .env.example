# Copy to .env.local and fill in. .env.local is gitignored.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com → API Keys). EMAIL_FROM must use a domain verified in Resend,
# or onboarding@resend.dev while testing (only delivers to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM="Sumz AI <onboarding@resend.dev>"

# OpenAI key for summaries (server-only), from platform.openai.com/api-keys. Starts with sk-
OPENAI_API_KEY=
# Optional: override the summary model
OPENAI_MODEL=gpt-5.4-mini

# Max summaries per user per day
SUMMARY_DAILY_LIMIT=25
