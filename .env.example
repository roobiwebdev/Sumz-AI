# Copy to .env.local and fill in. .env.local is gitignored.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com → API Keys). EMAIL_FROM must use a domain verified in Resend,
# or onboarding@resend.dev while testing (only delivers to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM="Sumz AI <onboarding@resend.dev>"

# RapidAPI "Article Extractor and Summarizer" key (server-only)
RAPIDAPI_KEY=

# Max summaries per user per day
SUMMARY_DAILY_LIMIT=25
